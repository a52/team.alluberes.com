# Azure DevOps Configuration
# Required for agent to connect to your Azure DevOps organization

# Your Azure DevOps organization URL
# Example: https://dev.azure.com/my-org
AZURE_DEVOPS_ORG=https://dev.azure.com/your-org

# Personal Access Token (PAT) for authentication
# Create one at: https://dev.azure.com/your-org/_usersSettings/tokens
# Scopes needed: Work Items (Read & Write)
AZURE_DEVOPS_PAT=your_personal_access_token_here

# Azure DevOps Project name
# Example: MyProject
AZURE_DEVOPS_PROJECT=YourProjectName

# Work Item Types to Process
# Comma-separated list of work item types
# Options: Epic, Feature, User Story, Task, Bug, etc.
WORK_ITEM_TYPES=Epic,Feature,User Story,Task,Bug

# Work Item Filters (JSON format)
# Define which work items to process
# Example: {"status": ["Active", "In Progress"], "area_path": "MyTeam"}
# Leave empty to process all items
WORK_ITEM_FILTERS={"status": ["Active"], "area_path": ""}

# Polishing Behavior Configuration

# Whether to auto-apply formatting changes (true) or suggest only (false)
AUTO_FORMAT_DESCRIPTIONS=true

# Whether to auto-fill missing story points (true) or skip (false)
AUTO_FILL_STORY_POINTS=true

# Default story points for auto-fill (if field is empty)
DEFAULT_STORY_POINTS=5

# Whether to standardize labels to lowercase-hyphenated format
AUTO_STANDARDIZE_LABELS=true

# Whether to auto-correct grammar/spelling (conservative)
AUTO_FIX_GRAMMAR=true

# Whether to auto-create links between related items
AUTO_LINK_RELATED_ITEMS=true

# Scheduler Configuration

# How often to run the agent (in minutes)
# Default: 5 (runs every 5 minutes)
SCHEDULE_INTERVAL_MINUTES=5

# Whether to run immediately on startup
RUN_ON_STARTUP=false

# Dashboard Configuration

# Port for the Flask web dashboard
DASHBOARD_PORT=5000

# Host to bind dashboard to (localhost for local only)
DASHBOARD_HOST=localhost

# Whether to enable dashboard
ENABLE_DASHBOARD=true

# Monitoring & Alerting

# Slack webhook URL for alerts (optional)
# Create a webhook at: https://api.slack.com/apps
# Leave empty to disable Slack notifications
SLACK_WEBHOOK_URL=

# Alert on high-priority items? (requires Slack webhook)
ENABLE_ALERTS=false

# Alert threshold: minimum priority to notify
# Options: low, medium, high, critical
ALERT_THRESHOLD=high

# Logging Configuration

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log directory (absolute or relative path)
LOG_DIR=./logs

# Log file name
LOG_FILE=agent.log

# Max log file size before rotation (in MB)
LOG_MAX_SIZE=100

# Number of log backups to keep
LOG_BACKUP_COUNT=10

# Development/Debug Configuration

# Enable debug mode (verbose logging, extra error details)
DEBUG=false

# Enable dry-run mode (log changes without applying them)
DRY_RUN=false

# Rate Limiting & Performance

# Respect Azure DevOps API rate limits
# Default recommended: 100 (very conservative)
# Higher = more requests per cycle
# Lower = safer but slower processing
RATE_LIMIT_PER_CYCLE=50

# Timeout for Azure API calls (seconds)
API_TIMEOUT_SECONDS=30

# Connection retry attempts on failure
MAX_RETRIES=3

# Backoff multiplier for exponential backoff (seconds)
RETRY_BACKOFF_MULTIPLIER=2

# Notes:
# 1. Never commit this file with real values - use .env.local instead
# 2. For production, use a secrets manager (Azure Key Vault, etc.)
# 3. PAT should have minimal required scopes for security
# 4. Always validate configuration on startup
