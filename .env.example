# Azure DevOps Configuration
# Required for agent to connect to your Azure DevOps organization

# Your Azure DevOps organization URL
# Example: https://dev.azure.com/my-org
AZURE_DEVOPS_ORG=https://dev.azure.com/your-org

# Personal Access Token (PAT) for authentication
# Create one at: https://dev.azure.com/your-org/_usersSettings/tokens
# Scopes needed: Work Items (Read & Write)
AZURE_DEVOPS_PAT=your_personal_access_token_here

# Azure DevOps Project name
# Example: MyProject
AZURE_DEVOPS_PROJECT=YourProjectName

# Work Item Types to Process
# Comma-separated; types that don't exist in your process template are ignored.
# Agile: User Story · Scrum: Product Backlog Item · Basic: Issue
WORK_ITEM_TYPES=Epic,Feature,User Story,Product Backlog Item,Issue,Task,Bug

# Work Item Filters (JSON format)
# exclude_states: skip items in these states (covers the finished states of Agile, Scrum and Basic)
# area_path: limit to an area path; empty = whole project
WORK_ITEM_FILTERS={"exclude_states": ["Closed", "Done", "Removed"], "area_path": ""}

# First start: how many days back to look for changed items (0 = only items changed after the agent starts)
INITIAL_LOOKBACK_DAYS=0

# Quiet period: only process items that have not changed for this many minutes,
# so the agent does not comment on an item someone is still writing
QUIET_PERIOD_MINUTES=30

# Polishing Behavior Configuration

# Missing required fields (estimate, acceptance criteria) are flagged, never auto-filled
FLAG_MISSING_FIELDS=true

# Tag aliases (JSON): only tags listed here are changed; others are reported, never touched
# Example: {"Front End": "front-end", "frontend": "front-end"}
TAG_ALIASES={}

# Post suggestions as work item comments (in addition to the dashboard).
# This is the only write made in suggest-only mode: one comment per suggestion,
# which adds a revision and notifies the item's followers. Set to false for no writes at all.
POST_SUGGESTION_COMMENTS=true

# Apply Mode
# DRY_RUN=true (default) is suggest-only: no work item field is ever changed.
# With DRY_RUN=false, only the rules enabled below are applied; the rest stay suggestions.
# Review dry-run output on your project before changing any of these.
DRY_RUN=true
APPLY_FORMATTING=false
APPLY_TAG_ALIASES=false

# Scheduler Configuration

# How often to run the agent (in minutes)
# Default: 5 (runs every 5 minutes)
SCHEDULE_INTERVAL_MINUTES=5

# Whether to run immediately on startup
RUN_ON_STARTUP=false

# Dashboard Configuration

# Port for the Flask web dashboard
# (5000 is avoided: macOS AirPlay Receiver listens on it)
DASHBOARD_PORT=8080

# Host to bind dashboard to (localhost for local only)
# Inside Docker use 0.0.0.0 and publish with -p 127.0.0.1:8080:8080 to stay local-only
DASHBOARD_HOST=localhost

# Whether to enable dashboard
ENABLE_DASHBOARD=true

# Logging Configuration

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log directory (absolute or relative path)
LOG_DIR=./logs

# Local state: last-run watermark, revisions written by the agent, posted suggestion hashes
# Mount as a Docker volume so it survives container restarts
STATE_DIR=./state

# Audit files older than this many days are compressed (never deleted)
AUDIT_RETENTION_DAYS=365

# Log file name
LOG_FILE=agent.log

# Max log file size before rotation (in MB)
LOG_MAX_SIZE=100

# Number of log backups to keep
LOG_BACKUP_COUNT=10

# Rate Limiting & Performance

# Maximum number of work items processed per cycle (keeps API usage low)
RATE_LIMIT_PER_CYCLE=50

# Timeout for Azure API calls (seconds)
API_TIMEOUT_SECONDS=30

# Connection retry attempts on failure
MAX_RETRIES=3

# Backoff multiplier for exponential backoff (seconds)
RETRY_BACKOFF_MULTIPLIER=2

# Notes:
# 1. Never put real values in this file - copy it to .env (git-ignored) and edit that
# 2. For production, use a secrets manager (Azure Key Vault, etc.)
# 3. PAT should have minimal required scopes for security
# 4. Always validate configuration on startup
